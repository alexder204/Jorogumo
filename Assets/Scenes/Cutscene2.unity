--- !u!114 &1259674401
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1259674400}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd19ca8fefb599c44a18fba2e22ad100, type: 3}
  m_Name: 
  m_EditorClassIdentifier: InventoryAssembly::SceneCGDialogueManager
  cutsceneCanvas: {fileID: 1367711971}
  dialogueCanvas: {fileID: 32236880}
  scenesParent: {fileID: 1748893313}
  speakerText: {fileID: 513784211}
  dialogueText: {fileID: 148943746}
  dialogueLines:
  - speaker: 
    dialogueWords: 
    showDialogueBox: 0
    allowDialogueToggle: 0
  - speaker: Lea
    dialogueWords: (Looks like everyone is here already...)
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: 
    dialogueWords: 
    showDialogueBox: 0
    allowDialogueToggle: 0
  - speaker: Lea
    dialogueWords: (Uh oh. She looks angry.)
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Mia
    dialogueWords: '"What took you so long?? You know we could have gotten caught
      by now."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: 
    dialogueWords: But clearly yelling isn't off the table!
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: June
    dialogueWords: "\"Let\u2019s just calm down, okay? She must have a good reason
      for keeping us waiting.\""
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Lea
    dialogueWords: '"..."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: June
    dialogueWords: '"Right...?"'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Lea
    dialogueWords: '"I was admiring nature."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: June
    dialogueWords: '"That''s... not good enough."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Mia
    dialogueWords: '"Ugh. Whatever. Did you at least bring something to help us get
      in?"'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Lea
    dialogueWords: '"..."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Mia
    dialogueWords: '"..."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Mia
    dialogueWords: "\"You\u2019re so useless... Can we just get inside already? Standing
      out here is literally the most suspicious thing we could be doing right now.\""
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Lea
    dialogueWords: '"...Yelling is also up there..."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: 
    dialogueWords: '!!!'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: 
    dialogueWords: 
    showDialogueBox: 0
    allowDialogueToggle: 0
  - speaker: 
    dialogueWords: 
    showDialogueBox: 0
    allowDialogueToggle: 0
  - speaker: 
    dialogueWords: 
    showDialogueBox: 0
    allowDialogueToggle: 0
  - speaker: Mia
    dialogueWords: '"How the... How did that work?!"'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Samuel
    dialogueWords: '"Who cares?"'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: 
    dialogueWords: Well, off you go!
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Samuel
    dialogueWords: "\"See? You didn\u2019t even need to bring anything.\""
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Lea
    dialogueWords: (Weirdo.)
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Mia
    dialogueWords: '"You were late and you showed up empty-handed."'
    showDialogueBox: 1
    allowDialogueToggle: 1
  - speaker: Mia
    dialogueWords: '"So make yourself useful and find us a way into the school."'
    showDialogueBox: 1
    allowDialogueToggle: 1
